# Source build for deployments that run this fork before upstream releases its fixes. Compiles the jar
# from this checkout and runs the full Maven verification (unit tests and ktlint), then replaces only the
# jar in the published image, so scripts, rootfs, Java runtime and entrypoint stay as released.
# Floating bases (owner, 2026-10-29: no pins that hold back updates); upstream publishes only `latest`.
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /src
COPY pom.xml .editorconfig ./
RUN mvn -B -q dependency:go-offline
COPY src ./src
RUN mvn -B verify \
 && test -s target/jitsi-multitrack-recorder-0.1-SNAPSHOT-jar-with-dependencies.jar

FROM jitsi/jitsi-multitrack-recorder:latest
LABEL org.opencontainers.image.source="https://github.com/jmdurant/jitsi-multitrack-recorder"
COPY --from=build /src/target/jitsi-multitrack-recorder-0.1-SNAPSHOT-jar-with-dependencies.jar /jmr/
